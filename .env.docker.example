# Puerto público del contenedor único.
APP_PORT=8080

# Debe contener al menos 32 caracteres. Usa un valor aleatorio en entornos compartidos.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# OpenAI es opcional para iniciar; sin la clave se utilizará el respaldo local disponible.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Google es opcional. Ambos valores corresponden al mismo OAuth Web Client ID.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Si cambias APP_PORT, actualiza también estos orígenes.
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
