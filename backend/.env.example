NODE_ENV=development
PORT=3000
# Reemplazar los valores entre < > con los datos de MongoDB Atlas.
MONGODB_URI=mongodb+srv://<database_user>:<database_password>@<cluster-host>/agora?retryWrites=true&w=majority
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
