{
  "name": "agora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST modular para el proyecto Ágora",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "nest build",
    "budget:reformat": "node --env-file-if-exists=.env scripts/reformat-budget-table.mjs",
    "db:ping": "node --env-file-if-exists=.env scripts/check-mongodb.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.6",
    "@openai/agents": "^0.16.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.0.2",
    "helmet": "8.1.0",
    "mongoose": "9.9.2",
    "openai": "^7.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.16",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "bcryptjs": "3.0.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.3.0",
    "jest": "29.7.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prettier": "3.7.4",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1"
  }
}
